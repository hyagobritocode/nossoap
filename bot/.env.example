# Copie para .env e preencha. Só a chave é obrigatória.

# Chave da API da Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Ler só os grupos cujo nome contém um destes pedaços (separe por vírgula).
# Vazio = todos os grupos. Maiúsculas e acentos não importam.
GRUPOS=achad,promo,oferta,cupom,desconto

# Nunca ler grupos com estes pedaços no nome (família, trabalho...).
GRUPOS_IGNORAR=

# No "Mensagem para você mesmo", responder só ao que começar com isto (ex.: ?).
# Vazio = responde a tudo que você escrever lá.
PREFIXO=

# Números (com DDI, ex. 5511999998888) que podem falar com o bot em conversa
# privada. Só precisa se o bot rodar num segundo número.
DONOS=

# Conectar por código de 8 letras em vez de QR: seu número com DDI.
PAREAR_NUMERO=

# Modelo e esforço. claude-sonnet-5 sai mais barato; esforço: low, medium, high.
CLAUDE_MODELO=claude-opus-5
CLAUDE_ESFORCO=medium

# Depois de quantas horas sem falar a conversa recomeça do zero.
CONVERSA_EXPIRA_HORAS=3

FUSO=America/Sao_Paulo
